#!/bin/bash
set -e

echo "=== Setting up environment ==="

mkdir -p "$HOME/.kh"

# Create ~/.kh/.aliases
cat > "$HOME/.kh/.aliases" << 'EOF'
# basics
alias ll='ls -alF'
alias install='sudo apt-get install -y'
alias purge='sudo apt-get remove --purge'
alias reinstall='sudo apt-get install --reinstall'
alias remove='sudo apt-get remove'
alias aremove='sudo apt-get autoremove'
alias search='apt-cache search'
alias show='apt-cache show'
alias update='sudo apt-get update'
alias upgrade='sudo apt-get upgrade'
alias watch='watch '
alias xargs='xargs '
alias myip='echo $(curl -s ifconfig.me)'

# misc
alias lsa='alias'
alias lsag='alias | grep $1'
alias lsf='compgen -A function | grep "^[a-z]\+" | grep -vE "^dequote|^quote|^in_array|^command_not_found_handle"'
alias lsfg='declare -f | grep $1'
alias ping='ping -c 5'
alias mkdir='mkdir -pv'

alias dnc='dotnet clean '
alias dnb='dotnet build '
alias dnf='dotnet format '
alias dnr='dotnet run '
alias dt='dotnet test '
alias clean='find . -type d -iname bin -prune -exec rm -rf {} \; && find . -type d -iname obj -prune -exec rm -rf {} \;'

# while I learn the git aliases in OMZ
alias lsg='alias | grep git'

# some backup stuff
alias mount-disk='lsblk -ouuid,name,size,type,mountpoint | grep -v loop | fzf --reverse | cut -d ' ' -f 1 | xargs -I{} sudo mount /dev/disk/by-uuid/{} /backups'
alias unmount-disk='lsblk -ouuid,name,size,type,mountpoint | grep -v loop | fzf --reverse | cut -d ' ' -f 1 | xargs -I{} sudo umount /dev/disk/by-uuid/{}'

alias ae='code -n ~/projects/ansible'
alias ou='omz update'
EOF
echo "  Created ~/.kh/.aliases"

# Create ~/.kh/.exports
cat > "$HOME/.kh/.exports" << 'EOF'

# path stuff
export PATH=$PATH:$HOME/.dotnet:$HOME/.local/bin:$HOME/go/bin

# editor
export EDITOR=nano

# Install Ruby Gems to ~/gems' >> ~/.bashrc
export GEM_HOME="$HOME/gems"
export PATH="$HOME/gems/bin:$PATH"

# Go path
export PATH="$PATH:/usr/local/go/bin"

export TERM=xterm-256color

#GPG
export GPG_KEY=$(tty)
export GPG_TTY=$(tty)
EOF
echo "  Created ~/.kh/.exports"

# Create ~/.kh/.functions
cat > "$HOME/.kh/.functions" << 'EOF'
#!/bin/bash

function gitnb { git checkout -b $1 && git push -u origin $1; }

function lsh {
    fc -lim "*$@*" 1
}

# command line calc
function =
{
  echo "$@" | bc -l
}
alias calc="="

function epoch {
    if [ $# -eq 1 ]; then
        date --date="$1" +%s
    else
        date +%s
    fi
}

function b64d()
{
    ENC_STR=$1
    if [[ $1 = grid-* ]]; then
        ENC_STR=${ENC_STR:5}
    fi
    DEC_STR=$(echo "$ENC_STR" | base64 -d 2>/dev/null)
    if [[ $DEC_STR = *invalid ]]; then
        DEC_STR=$(echo "$ENC_STR=" | base64 -d 2>/dev/null)
    fi
    if [[ $DEC_STR = *invalid ]]; then
        DEC_STR=$(echo "$ENC_STR==" | base64 -d)
    fi
    echo ""
    echo "$DEC_STR"
}

function d64()
{
    b64d $1
}
EOF
echo "  Created ~/.kh/.functions"

# Add 'kh' alias to shell rc files
KH_ALIAS="alias kh='source \$HOME/.kh/.exports && source \$HOME/.kh/.aliases && source \$HOME/.kh/.functions'"
for RC_FILE in "$HOME/.bashrc" "$HOME/.zshrc"; do
    if [ -f "$RC_FILE" ]; then
        if ! grep -q "alias kh=" "$RC_FILE" 2>/dev/null; then
            echo "" >> "$RC_FILE"
            echo "$KH_ALIAS" >> "$RC_FILE"
            echo "  Added 'kh' alias to $(basename $RC_FILE)"
        fi
    fi
done

# Ask about work aliases (encrypted bundle)
echo ""
read -p "Do you also want to install WORK aliases? [y/N] " -n 1 -r < /dev/tty
echo ""

if [[ $REPLY =~ ^[Yy]$ ]]; then
    echo ""
    read -s -p "Enter decryption password: " WORK_PASS < /dev/tty
    echo ""

    # Encrypted work aliases (openssl aes-256-cbc, pbkdf2, base64-encoded)
    WORK_ALIASES_ENC=""

    # Encrypted work functions (openssl aes-256-cbc, pbkdf2, base64-encoded)
    WORK_FUNCTIONS_ENC=""

    # Decrypt and append
    DECRYPTED_ALIASES=$(echo "$WORK_ALIASES_ENC" | base64 -d | openssl enc -aes-256-cbc -d -pbkdf2 -pass pass:"$WORK_PASS" 2>/dev/null)
    if [ $? -ne 0 ]; then
        echo "  ERROR: Decryption failed. Wrong password?"
    else
        echo "" >> "$HOME/.kh/.aliases"
        echo "$DECRYPTED_ALIASES" >> "$HOME/.kh/.aliases"
        echo "  Added work aliases"

        DECRYPTED_FUNCTIONS=$(echo "$WORK_FUNCTIONS_ENC" | base64 -d | openssl enc -aes-256-cbc -d -pbkdf2 -pass pass:"$WORK_PASS" 2>/dev/null)
        if [ $? -eq 0 ]; then
            echo "" >> "$HOME/.kh/.functions"
            echo "$DECRYPTED_FUNCTIONS" >> "$HOME/.kh/.functions"
            echo "  Added work functions"
        fi
    fi

    unset WORK_PASS DECRYPTED_ALIASES DECRYPTED_FUNCTIONS
fi

echo ""
echo "=== Done! ==="
echo "Type 'kh' (or open a new shell first) to activate your environment."
