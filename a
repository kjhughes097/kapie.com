#!/bin/sh
set -e

echo "=== Setting up environment ==="

umask 077
mkdir -p "$HOME/.kh"
chmod 700 "$HOME/.kh"

# Create ~/.kh/.aliases
cat > "$HOME/.kh/.aliases" << 'EOF'
# basics
alias ll='ls -alF'
alias install='sudo apt-get install -y'
alias purge='sudo apt-get remove --purge'
alias reinstall='sudo apt-get install --reinstall'
alias remove='sudo apt-get remove'
alias aremove='sudo apt-get autoremove'
alias search='apt-cache search'
alias show='apt-cache show'
alias update='sudo apt-get update'
alias upgrade='sudo apt-get upgrade'
alias watch='watch '
alias xargs='xargs '
alias myip='curl -fsS ifconfig.me'

# misc
alias lsa='alias'
alias ping='ping -c 5'
alias mkdir='mkdir -pv'

alias dnc='dotnet clean '
alias dnb='dotnet build '
alias dnf='dotnet format '
alias dnr='dotnet run '
alias dnt='dotnet test '
alias dn='dotnet '
alias clean='find . -type d -iname bin -prune -exec rm -rf {} \; && find . -type d -iname obj -prune -exec rm -rf {} \;'

alias ou='omz update'
EOF
echo "  Created ~/.kh/.aliases"

# Create ~/.kh/.exports
cat > "$HOME/.kh/.exports" << 'EOF'

# path stuff
for kh_path in "$HOME/.dotnet" "$HOME/.local/bin" "$HOME/go/bin" /usr/local/go/bin; do
    case ":$PATH:" in
        *":$kh_path:"*) ;;
        *) PATH="$PATH:$kh_path" ;;
    esac
done
unset kh_path
export PATH

# editor
export EDITOR=nano

export TERM=xterm-256color

#GPG
if [ -t 0 ]; then
    GPG_KEY=$(tty)
    GPG_TTY=$GPG_KEY
    export GPG_KEY GPG_TTY
fi
EOF
echo "  Created ~/.kh/.exports"

# Create ~/.kh/.functions
cat > "$HOME/.kh/.functions" << 'EOF'
for kh_alias in lsag lsf lsfg; do
    if alias "$kh_alias" >/dev/null 2>&1; then
        unalias "$kh_alias"
    fi
done
unset kh_alias

gitnb() { git checkout -b "$1" && git push -u origin "$1"; }

lsag() { alias | grep -F -- "$1"; }

lsf() {
    if [ -n "${BASH_VERSION:-}" ]; then
        compgen -A function | grep '^[a-z]' | grep -vE '^(dequote|quote|in_array|command_not_found_handle)'
    elif [ -n "${ZSH_VERSION:-}" ]; then
        typeset -f | grep '^[a-z][a-zA-Z0-9_]* () {' | sed 's/ () {.*//'
    else
        echo "lsf requires Bash or Zsh" >&2
        return 1
    fi
}

lsfg() { lsf | grep -F -- "$1"; }

lsh() { fc -l 1 | grep -F -- "$*"; }

epoch() {
    if [ $# -eq 1 ]; then
        date --date="$1" +%s
    else
        date +%s
    fi
}

d64() (
    enc_str=${1#grid-}
    dec_str=$(printf '%s' "$enc_str" | base64 -d 2>/dev/null) ||
        dec_str=$(printf '%s=' "$enc_str" | base64 -d 2>/dev/null) ||
        dec_str=$(printf '%s==' "$enc_str" | base64 -d) || return 1
    printf '\n%s\n' "$dec_str"
)

EOF
echo "  Created ~/.kh/.functions"

# Files are shared by POSIX shells; keep this entry point usable with `.`.
cat > "$HOME/.kh/init" << 'EOF'
. "$HOME/.kh/.exports"
. "$HOME/.kh/.aliases"
. "$HOME/.kh/.functions"
EOF
chmod 600 "$HOME/.kh/.exports" "$HOME/.kh/.aliases" "$HOME/.kh/.functions" "$HOME/.kh/init"

ZSH_RC="${ZDOTDIR:-$HOME}/.zshrc"
for RC_FILE in "$HOME/.profile" "$HOME/.bashrc"; do
    if ! [ -f "$RC_FILE" ] || ! grep -Fqx '. "$HOME/.kh/init" # kh environment' "$RC_FILE"; then
        printf '\n%s\n' '. "$HOME/.kh/init" # kh environment' >> "$RC_FILE"
        echo "  Enabled environment in $(basename "$RC_FILE")"
    fi
done

HAVE_TTY=no
if [ -t 2 ] && ( : < /dev/tty ) 2>/dev/null; then
    HAVE_TTY=yes
fi

MISSING=
for DEPENDENCY in zsh git; do
    if ! command -v "$DEPENDENCY" >/dev/null 2>&1; then
        MISSING="$MISSING $DEPENDENCY"
    fi
done

if [ -n "$MISSING" ]; then
    echo "Oh My Zsh requires missing dependencies:$MISSING" >&2
    INSTALL_REPLY=
    if [ "$HAVE_TTY" = yes ]; then
        printf 'Install missing dependencies using the system package manager? [y/N] ' > /dev/tty
        IFS= read -r INSTALL_REPLY < /dev/tty || INSTALL_REPLY=
    fi
    case "$INSTALL_REPLY" in
        [Yy]|[Yy][Ee][Ss])
            if [ "$(id -u)" -eq 0 ]; then
                SUDO=
            elif command -v sudo >/dev/null 2>&1; then
                SUDO=sudo
            else
                echo "ERROR: sudo is required to install dependencies." >&2
                exit 1
            fi
            if command -v apt-get >/dev/null 2>&1; then
                $SUDO apt-get update < /dev/tty
                # MISSING contains only the fixed package names above.
                $SUDO apt-get install -y $MISSING < /dev/tty
            elif command -v dnf >/dev/null 2>&1; then
                $SUDO dnf install -y $MISSING < /dev/tty
            elif command -v apk >/dev/null 2>&1; then
                $SUDO apk add $MISSING < /dev/tty
            else
                echo "ERROR: No supported package manager found; install$MISSING manually." >&2
                exit 1
            fi
            for DEPENDENCY in $MISSING; do
                if ! command -v "$DEPENDENCY" >/dev/null 2>&1; then
                    echo "ERROR: $DEPENDENCY is still unavailable after installation." >&2
                    exit 1
                fi
            done
            MISSING=
            ;;
        *) echo "Oh My Zsh was not installed; install$MISSING and rerun this script." >&2 ;;
    esac
fi

if [ -z "$MISSING" ]; then
    if [ ! -e "$HOME/.oh-my-zsh" ]; then
        echo "Installing Oh My Zsh..."
        git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git "$HOME/.oh-my-zsh"
    fi
    if [ ! -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]; then
        echo "ERROR: $HOME/.oh-my-zsh exists but is not a valid Oh My Zsh installation." >&2
        exit 1
    fi
    cat > "$HOME/.kh/theme.zsh" << 'EOF'
prompt_colour() {
    if [[ -n ${SSH_TTY:-} ]]; then
        echo "10"
    else
        echo "226"
    fi
}

setopt prompt_subst
PROMPT='%F{$(prompt_colour)}%n@%m%f %D{%T} %2~ $(git_prompt_info) # '
ZSH_THEME_GIT_PROMPT_PREFIX="%B%F{124}["
ZSH_THEME_GIT_PROMPT_SUFFIX="]%f%b"
ZSH_THEME_GIT_PROMPT_DIRTY="*"
ZSH_THEME_GIT_PROMPT_CLEAN=""
EOF
    chmod 600 "$HOME/.kh/theme.zsh"
    if ! [ -f "$ZSH_RC" ] || ! grep -Eq '^[[:space:]]*(source|\.)[[:space:]]+.*oh-my-zsh\.sh' "$ZSH_RC"; then
        cat >> "$ZSH_RC" << 'EOF'

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="${ZSH_THEME:-robbyrussell}"
source "$ZSH/oh-my-zsh.sh"
EOF
        if grep -Fqx '. "$HOME/.kh/init" # kh environment' "$ZSH_RC"; then
            printf '%s\n' '. "$HOME/.kh/init" # kh environment after Oh My Zsh' >> "$ZSH_RC"
        fi
        echo "  Enabled Oh My Zsh in $ZSH_RC"
    fi
    if ! grep -Fqx '. "$HOME/.kh/theme.zsh" # kh theme' "$ZSH_RC"; then
        printf '\n%s\n' '. "$HOME/.kh/theme.zsh" # kh theme' >> "$ZSH_RC"
        echo "  Enabled custom theme in $ZSH_RC"
    fi

    SHELL_REPLY=
    if [ "$HAVE_TTY" = yes ] && [ "$(basename "${SHELL:-}")" != zsh ]; then
        printf '\nChange your default shell to Zsh? [y/N] ' > /dev/tty
        IFS= read -r SHELL_REPLY < /dev/tty || SHELL_REPLY=
    fi
    case "$SHELL_REPLY" in
        [Yy]|[Yy][Ee][Ss])
            if ! command -v chsh >/dev/null 2>&1; then
                echo "ERROR: chsh is unavailable; change your shell to Zsh manually." >&2
                exit 1
            fi
            chsh -s "$(command -v zsh)" < /dev/tty
            echo "  Default shell changed; start a new login session to apply."
            ;;
    esac
fi

if ! [ -f "$ZSH_RC" ] || ! grep -Fqx '. "$HOME/.kh/init" # kh environment' "$ZSH_RC"; then
    printf '\n%s\n' '. "$HOME/.kh/init" # kh environment' >> "$ZSH_RC"
    echo "  Enabled environment in $ZSH_RC"
fi

DOCKER_REPLY=
if [ "$HAVE_TTY" = yes ]; then
    printf '\nAdd your user to the docker group? This grants root-equivalent access. [y/N] ' > /dev/tty
    IFS= read -r DOCKER_REPLY < /dev/tty || DOCKER_REPLY=
fi
case "$DOCKER_REPLY" in
    [Yy]|[Yy][Ee][Ss])
        sudo usermod -aG docker "$(id -un)"
        echo "  Added user to docker group; start a new login session to apply."
        ;;
esac

echo ""
echo "=== Done! ==="
echo 'Open a new shell, or run: . "$HOME/.kh/init"'
if [ "$HAVE_TTY" = no ]; then
    echo "No terminal available; skipped the optional shell and Docker prompts."
fi
